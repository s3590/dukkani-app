# ================= إعدادات قواعد البيانات (تعمل مع Docker تلقائياً) =================
DATABASE_URL=postgres://dukkani_user:StrongPassword123@db:5432/dukkani_db
REDIS_URL=redis://redis:6379/0

# ================= إعدادات تيليجرام =================
# توكن البوت الذي حصلت عليه من BotFather
BOT_TOKEN=ضع_توكن_البوت_هنا

# الآيدي الخاص بك كمدير عام (أرقام فقط)
ADMIN_ID=ضع_الآيدي_الخاص_بك_هنا

# آيدي الجروب الذي سيتم إرسال النسخ الاحتياطية إليه (اختياري، يمكنك تركه فارغاً أو وضع الآيدي الخاص بك)
ARCHIVE_GROUP_ID=ضع_آيدي_الجروب_هنا

# ================= إعدادات الأمان ولوحة التحكم =================
# كلمة سر قوية وعشوائية لتشفير الجلسات (اكتب أي حروف وأرقام عشوائية طويلة)
JWT_SECRET=a_very_long_and_secure_random_string_here_12345!

# كلمة المرور التي ستدخل بها إلى لوحة تحكم الإدارة العليا في الويب
ADMIN_PASSWORD=ضع_كلمة_مرور_قوية_هنا

# ================= إعدادات فايربيس للإشعارات =================
# افتح ملف firebase-adminsdk.json، انسخ كل ما بداخله، والصقه هنا بين علامتي التنصيص المفردة (يجب أن يكون في سطر واحد)
FIREBASE_CREDENTIALS='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'
